            const From = sha256(publicKey);
            const To = From;
            const Nonce = '0';
            const Type = 'C_TYPE_REGISTERWALLET';
    
            const PayloadObj = {
                "Action": "CP_REGISTERWALLET",
                "PublicKey": publicKey

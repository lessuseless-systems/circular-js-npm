{
  "author": "Danny De Novi",
  "bugs": {
    "url": "https://github.com/circular-protocol/circular-protocol-ts/issues"
  },
  "dependencies": {
    "elliptic": "^6.5.7",
    "node-fetch": "^3.3.2",
    "sha256": "^0.2.0"
  },
  "description": "Official API specification for Circular Protocol blockchain operations and wallet management",
  "devDependencies": {
    "@types/elliptic": "^6.4.18",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/sha256": "^0.2.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/circular-protocol/circular-protocol-ts#readme",
  "keywords": [
    "Blockchain",
    "Circular",
    "Protocol",
    "Smart",
    "Contracts",
    "Web",
    "3.0",
    "SDK",
    "API",
    "TypeScript"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "name": "circular-protocol-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/circular-protocol/circular-protocol-ts.git"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "webpack --config webpack.config.cjs.js",
    "build:esm": "webpack --config webpack.config.esm.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.8"
}
